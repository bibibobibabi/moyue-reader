{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Moyue Reader",
  "version": "1.0.0",
  "identifier": "com.moyue.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "墨阅 Moyue Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss: https://tts-api.xfyun.cn https://*.aliyun.com; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'"
    }
  },
"bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 34,
      "versionCode": 1
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": ["$APPLOCALDATA/**", "$DOWNLOAD/**", "$DOCUMENT/**", "$DESKTOP/**"]
    },
    "sql": {
      "preload": ["sqlite:moyue.db"]
    }
  }
}
